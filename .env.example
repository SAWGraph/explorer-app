VITE_API_BASE_URL=http://localhost:3001

# Retry and split what the knowledge graph refuses (timeout, out of memory, too large)
# so a run still answers. Default on; set to false to see the first error instead.
# VITE_CHUNK_ON_REFUSAL=false
