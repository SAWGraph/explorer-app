VITE_API_BASE_URL=http://localhost:3001

# Split a query the knowledge graph refuses (timeout, out of memory, too large)
# into smaller ones. Default on; set to false to see the refusal as an error.
# VITE_CHUNK_ON_REFUSAL=false
